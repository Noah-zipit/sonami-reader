<?xml version="1.0" encoding="utf-8"?>
<!-- SONAMI: adaptive launcher icon. Background is flat indigo; foreground is
     the transparent moon mark scaled to the 72dp safe zone, so the system
     mask (squircle/circle) never clips the artwork or shows white corners.
     Pre-Oreo devices fall back to the rounded legacy mipmap PNGs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_sonami_foreground" />
</adaptive-icon>
